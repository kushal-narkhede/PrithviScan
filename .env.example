# Copy to .secrets/earthdata.env (gitignored) — never commit real tokens.
# Then upload to Firebase Secret Manager:
#   firebase functions:secrets:set EARTHDATA_TOKEN
EARTHDATA_TOKEN=paste_your_earthdata_bearer_token_here

# Tomorrow.io — hyperlocal weather (forecast + farm advisories)
# Create a key at https://app.tomorrow.io → Development → API Keys
# Copy to .secrets/tomorrow.env then run:
#   bash scripts/set-tomorrow-secret.sh
#   npx firebase-tools deploy --only functions --project prithviscan
# TOMORROW_API_KEY=

# India localization (Bhuvan / Bhoonidhi / IMD / Agmarknet)
# See docs/INDIA_DATA.md — copy to .secrets/india.env then:
#   bash scripts/set-india-secrets.sh
# BHUVAN_API_TOKEN=          # https://bhuvan-app1.nrsc.gov.in/api/
# BHOONIDHI_TOKEN=           # or USER+PASSWORD; request: bhoonidhi@nrsc.gov.in
# BHOONIDHI_USER=
# BHOONIDHI_PASSWORD=
# IMD_API_KEY=               # https://api.imd.gov.in
# DATA_GOV_IN_API_KEY=       # https://data.gov.in (Agmarknet mandi prices)

# Ask AI — Ollama runs locally (browser → http://localhost:11434).
# Gemini / OpenRouter: paste keys in Ask AI → Settings for testing, or set
# as Cloud Functions secrets after Blaze and wire into exports.aiChat:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set OPENROUTER_API_KEY
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
