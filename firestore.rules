rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.memberIds;
    }

    // Public discoverable profiles (email lookup for friend requests)
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.emailLower is string;
      allow delete: if isSelf(userId);
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);

      match /friends/{friendId} {
        allow read: if isSelf(userId);
        // Either side may write friendship docs during accept / remove
        allow create, update: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
        allow delete: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /fields/{fieldId} {
        allow read, write: if isSelf(userId);

        match /snapshots/{dateId} {
          allow read: if isSelf(userId);
          allow write: if false;
        }

        match /insights/{insightId} {
          allow read: if isSelf(userId);
          allow write: if false;
        }

        match /feedback/{feedbackId} {
          allow read, create: if isSelf(userId);
          allow update, delete: if false;
        }
      }

      match /alerts/{alertId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "declined"];
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    match /conversations/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 30;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /fieldShares/{shareId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.sharedWithUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sharedWithUid is string
        && request.resource.data.fieldId is string;
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.sharedWithUid == request.auth.uid);
      allow update: if false;
    }
  }
}
