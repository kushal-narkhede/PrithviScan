rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // No access to anything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Each user owns exactly their own subtree
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /fields/{fieldId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // snapshots and insights are written by Cloud Functions (admin SDK bypasses rules)
        // client reads are allowed so the UI can display cached data
        match /snapshots/{dateId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false; // Functions only
        }

        match /insights/{insightId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false; // Functions only
        }
      }

      match /alerts/{alertId} {
        allow read:   if request.auth != null && request.auth.uid == userId;
        allow write:  if false; // Functions only — clients call markAlertRead endpoint
      }
    }
  }
}
